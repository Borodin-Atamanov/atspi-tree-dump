#!/usr/bin/env bash
# Bump the atspi-tree-dump version before every commit.
# Best-effort by design: any failure prints a warning to stderr and the
# hook still exits 0, so a broken bump never blocks a commit. The version
# grows by one patch step on each successful run; the single version
# source is src/atspi_tree_dump/__init__.py.
set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
    echo "atspi-tree-dump pre-commit: not a git repository, skipping version bump" >&2
    exit 0
fi

if ! PYTHONPATH="$repo_root/src" python3 -m atspi_tree_dump.bump_version --root "$repo_root" >/dev/null 2>&1; then
    echo "atspi-tree-dump pre-commit: version bump failed, committing without it" >&2
    exit 0
fi

# Refresh the lock so the project version in uv.lock matches the bumped one.
if (cd "$repo_root" && uv lock >/dev/null 2>&1); then
    git add "$repo_root/uv.lock"
fi

git add "$repo_root/src/atspi_tree_dump/__init__.py"
exit 0
